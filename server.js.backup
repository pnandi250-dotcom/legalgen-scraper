      { id: 'gst-services', name: 'GST (Services)', applicability: 'mandatory', penalty: 'Tax evasion' }
    ],

    requiredPages: [
      {
        type: 'privacy-policy',
        label: 'Privacy Policy',
        priority: 'high',
        reason: 'Client data, visitor analytics, contact forms',
        riskIfMissing: 'Client trust issues, DPDP risk',
        effort: 'medium',
        templateAvailable: true,
        urgency: 'recommended'
      },
      {
        type: 'service-terms',
        label: 'Service Terms / Engagement Terms',
        priority: 'high',
        reason: 'Scope creep protection, payment terms, IP ownership',
        riskIfMissing: 'Scope creep disputes, payment delays',
        effort: 'large',
        templateAvailable: true,
        urgency: 'recommended'
      },
      {
        type: 'data-processing',
        label: 'Client Data Processing Terms',
        priority: 'medium',
        reason: 'How agency handles client data, campaigns, analytics',
        riskIfMissing: 'Client data breach = agency liable',
        effort: 'medium',
        templateAvailable: true,
        urgency: 'recommended'
      }
    ],

    optionalPages: [
      { type: 'team', label: 'Team Page', reason: 'Trust, expertise showcase' },
      { type: 'process', label: 'Process/Methodology', reason: 'Differentiation' },
