const express = require('express');
const cors = require('cors');
const rateLimit = require('express-rate-limit');
const crypto = require('crypto');

const app = express();
const PORT = process.env.PORT || 3001;

const CONFIG = {
  API_KEY: process.env.SCRAPER_API_KEY || 'legalgen-v2-key-2024',
  ALLOWED_ORIGINS: (process.env.ALLOWED_ORIGINS || 'http://localhost:3000').split(','),
  USER_AGENT: 'LegalGen-Pro/3.0'
};

app.use(express.json());
app.use(cors({ origin: CONFIG.ALLOWED_ORIGINS }));
app.use(rateLimit({ windowMs: 15 * 60 * 1000, max: 50 }));

function auth(req, res, next) {
  const key = req.headers['x-api-key'];
  if (!key || key !== CONFIG.API_KEY) return res.status(401).json({ error: 'Invalid API key' });
  next();
}

function isValidURL(url) {
  try {
    const u = new URL(url);
    return ['http:', 'https:'].includes(u.protocol) && !u.hostname.match(/^(localhost|127\.|10\.|172\.(1[6-9]|2\d|3[01])\.|192\.168\.)/);
  } catch { return false; }
}

