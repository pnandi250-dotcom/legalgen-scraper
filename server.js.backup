    ]
  }
};

// ---------------------------------------------------------------
// ADVANCED DETECTION FUNCTIONS
// ---------------------------------------------------------------

/**
 * Multi-signal business type detection
 */
function detectBusinessTypeAdvanced(html, url, technologies) {
  const scores = {};
  const evidence = {};

  const hostname = new URL(url).hostname;
  const tld = hostname.split('.').pop();

  for (const [type, profile] of Object.entries(BUSINESS_PROFILES)) {
    let score = 0;
    const matchedSignals = [];

    // 1. HTML Pattern Matching (strongest signal)
    if (profile.signals.htmlPatterns) {
      for (const signal of profile.signals.htmlPatterns) {
        if (signal.pattern.test(html)) {
          score += signal.weight;
          matchedSignals.push(signal.label);
        }
      }
    }

    // 2. URL Structure Analysis
    if (profile.signals.urlPatterns) {
      for (const pattern of profile.signals.urlPatterns) {
        if (pattern.test(url)) {
          score += 3;
          matchedSignals.push(`URL contains ${pattern}`);
        }
      }
    }

    // 3. Technology Detection
    if (profile.signals.techPatterns && technologies.scripts) {
      for (const script of technologies.scripts) {
        for (const pattern of profile.signals.techPatterns) {
          if (pattern.test(script.name || script.source || '')) {
            score += 4;
            matchedSignals.push(`Tech: ${script.name || pattern}`);
          }
        }
      }
    }

    // 4. Payment Gateway Detection (e-commerce indicator)
    if (type === 'ecommerce' && technologies.payments && technologies.payments.length > 0) {
      score += 5 * technologies.payments.length;
      matchedSignals.push(`Payments: ${technologies.payments.map(p => p.name).join(', ')}`);
    }

    // 5. Domain TLD Analysis
    const tldIndicators = {
      'ecommerce': ['.shop', '.store'],
      'finance': ['.finance', '.money'],
      'education': ['.edu', '.academy']
    };

    if (tldIndicators[type]?.some(t => hostname.includes(t))) {
      score += 2;
      matchedSignals.push(`Domain suggests ${type}`);
    }

    scores[type] = score;
    evidence[type] = matchedSignals;
  }

  // Sort and find winner
  const sorted = Object.entries(scores).sort((a, b) => b[1] - a[1]);
  const topType = sorted[0];
  const secondType = sorted[1];

  // Calculate confidence
  let confidence;
  if (topType[1] === 0) {
    confidence = 15; // Unknown
  } else if (!secondType || secondType[1] === 0) {
    confidence = 90; // Clear winner
  } else {
    confidence = Math.min(95, Math.round((topType[1] / (topType[1] + secondType[1])) * 100));
  }

  return {
    type: topType[0],
    name: BUSINESS_PROFILES[topType[0]]?.name || 'Unknown',
    icon: BUSINESS_PROFILES[topType[0]]?.icon || '??',
    score: topType[1],
    confidence,
    evidence: evidence[topType[0]],
    alternatives: sorted
      .filter(([_, s]) => s > 3 && s < topType[1])
      .slice(0, 3)
      .map(([t]) => ({
        type: t,
        name: BUSINESS_PROFILES[t]?.name,
        score: scores[t]
      })),
    profile: BUSINESS_PROFILES[topType[0]]
  };
}

/**
 * Check which required pages exist
 */
function checkRequiredPages(html, url, businessProfile) {
  const links = [...html.matchAll(/<a[^>]*href=["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/gi)]
    .map(m => ({ url: m[1], text: m[2].replace(/<[^>]+/g, '').toLowerCase() }));

  const found = [];
  const missing = [];

  if (!businessProfile.requiredPages) return { found, missing, totalRequired: 0, totalFound: 0 };

  for (const page of businessProfile.requiredPages) {
    // Build smart patterns for each page type
    const patterns = {
      'privacy-policy': /privacy|data.protection|data.policy/i,
      'terms-of-service': /terms|tos|conditions|terms.of.use/i,
      'refund-policy': /refund|return|money.back|cancellation.policy/i,
      'cancellation-policy': /cancel|cancellation/i,
      'shipping-delivery': /shipping|delivery|fulfillment/i,
      'cookie-policy': /cookie|use.of.cookie/i,
      'sla': /sla|service.level|uptime.guarantee/i,
      'acceptable-use': /acceptable.use|aup|usage.policy/i,
      'dpa': /dpa|data.processing|processor/i,
      'gdpr-compliance': /gdpr|eu.privacy|data.protection.officer/i,
      'risk-disclosure': /risk|disclosure|investment.risk/i,
      'grievance-redressal': /grievance|complaint|ombudsman|redressal/i,
      'licenses': /license|registration|rbi|sebi|irdai/i,
      'security-practices': /security|information.security|iso|soc/i,
      'medical-disclaimer': /medical.disclaimer|health.disclaimer|not.a.doctor/i,
      'doctor-credentials': /doctor|credential|qualification|registration/i,
      'patient-rights': /patient.rights|rights.responsibilities/i,
      'data-security': /data.security|encryption|secure/i,
      'emergency-disclaimer': /emergency|not.emergency|call.911/i,
      'intellectual-property', 'ip', 'intellectual.property',
      'accreditation': | accreditation | certified | recognized | approved / i,
      'accessibility': | accessibility | wcag | a11y | screen.reader / i,
      'service-terms': /service.terms|engagement.terms|agreement/i,
      'data-processing': /data.processing|client.data|handling/i
    };

    const pattern = patterns[page.type] || new RegExp(page.type.replace('-', '.?'));
    const isFound = links.some(l => pattern.test(l.url) || pattern.test(l.text));

    if (isFound) {
      found.push({
        ...page,
        status: 'found',
        detectedAt: new Date().toISOString()
      });
    } else {
      missing.push({
        ...page,
        status: 'missing',
        detectedAt: null,
        daysOverdue: 'N/A',
        estimatedCostOfNonCompliance: estimatePenalty(page, businessProfile.type),
        recommendedTemplate: page.templateAvailable ? `${page.type}-template` : 'custom-required'
      });
    }
  }

  return {
    found,
    missing,
    totalRequired: businessProfile.requiredPages.length,
    totalFound: found.length,
    compliancePercentage: Math.round((found.length / businessProfile.requiredPages.length) * 100)
  };
}

/**
 * Estimate penalty for non-compliance
 */
function estimatePenalty(page, businessType) {
  const penalties = {
    critical: { min: 50000, max: 5000000, unit: 'INR', additional: 'Possible imprisonment' },
    high: { min: 10000, max: 500000, unit: 'INR', additional: '' },
    medium: { min: 5000, max: 100000, unit: 'INR', additional: '' },
    low: { min: 1000, max: 25000, unit: 'INR', additional: '' }
  };

  const tier = penalties[page.priority] || penalties.medium;

  return {
    range: `?${tier.min.toLocaleString()} - ?${tier.max.toLocaleString()}`,
    additionalInfo: tier.additional,
    worstCase: `?${tier.max.toLocaleString()}${tier.additional ? ' + ' + tier.additional : ''}`
  };
}

/**
 * Generate actionable recommendations
 */
function generateRecommendations(businessDetection, pageCheck, technologies) {
  const recommendations = [];

  // Critical missing pages first
  for (const page of pageCheck.missing.filter(p => p.priority === 'critical')) {
    recommendations.push({
      id: `rec-${page.type}`,
      priority: 'immediate',
      category: 'legal-compliance',
      title: `Create ${page.label}`,
      description: page.reason,
      impact: {
        riskReduction: 25,
        trustImprovement: 20,
        penaltyAvoidance: page.estimatedCostOfNonCompliance?.worstCase
      },
      effort: page.effort,
      estimatedTime: page.effort === 'small' ? '2-4 hours' : page.effort === 'medium' ? '1-2 days' : '1-2 weeks',
      hasTemplate: page.templateAvailable,
      urgency: page.urgency,
      regulation: businessDetection.profile.regulations?.find(r => r.applicability === 'mandatory')?.name || 'General'
    });
  }

  // High priority items
  for (const page of pageCheck.missing.filter(p => p.priority === 'high')) {
    recommendations.push({
      id: `rec-${page.type}`,
      priority: 'urgent',
      category: 'operational',
      title: `Add ${page.label}`,
      description: page.reason,
      impact: {
        riskReduction: 15,
        trustImprovement: 15,
        penaltyAvoidance: page.estimatedCostOfNonCompliance?.range
      },
      effort: page.effort,
      estimatedTime: page.effort === 'small' ? '2-4 hours' : page.effort === 'medium' ? '1 day' : '3-5 days',
      hasTemplate: page.templateAvailable,
      urgency: page.urgency
    });
  }

  // Technology-specific recommendations
  if (technologies.cookies && technologies.cookies.length > 5) {
    recommendations.push({
      id: 'rec-cookie-consent',
      priority: 'urgent',
      category: 'technology',
      title: 'Implement Cookie Consent Banner',
      description: `Detected ${technologies.cookies.length} cookie types including tracking`,
      impact: {
        riskReduction: 20,
        trustImprovement: 25,
        penaltyAvoidance: 'IT Rules 2021 compliance'
      },
      effort: 'medium',
      estimatedTime: '1-2 days',
      hasTemplate: true,
      urgency: 'urgent'
    });
  }

  if (technologies.payments && technologies.payments.length > 0) {
    recommendations.push({
      id: 'rec-payment-security',
      priority: 'recommended',
      category: 'technology',
      title: 'Display Payment Security Badges',
      description: `Uses ${technologies.payments.map(p => p.name).join(', ')}. Show security certifications.`,
      impact: {
        riskReduction: 10,
        trustImprovement: 30,
        conversionImpact: '+5-10% checkout completion'
      },
      effort: 'small',
      estimatedTime: '1-2 hours',
      hasTemplate: false,
      urgency: 'recommended'
    });
  }

  // Sort by priority
  const priorityOrder = { immediate: 0, urgent: 1, recommended: 2, optional: 3 };
  recommendations.sort((a, b) => priorityOrder[a.priority] - priorityOrder[b.priority]);

  return recommendations;
}

// ---------------------------------------------------------------
// MAIN SCAN FUNCTION (ULTRA SMART VERSION)
// ---------------------------------------------------------------

async function scanWebsiteUltraSmart(url) {
  if (!isValidURL(url)) throw new Error('Invalid URL');

  const startTime = Date.now();

  try {
    const resp = await fetch(url, {
      headers: { 'User-Agent': CONFIG.USER_AGENT }
    });
    const html = await resp.text();

    // Detect basic technologies
    const cookies = [], scripts = [], payments = [];

    if (html.includes('_ga')) cookies.push({ name: '_ga', vendor: 'Google Analytics', category: 'analytics' });
    if (html.includes('_fbp')) cookies.push({ name: '_fbp', vendor: 'Facebook Pixel', category: 'advertising' });
    if (html.includes('_gcl_au')) cookies.push({ name: '_gcl_au', vendor: 'Google Ads', category: 'advertising' });

    const scriptMatches = html.match(/<script[^>]*src=["']([^"']+)["'][^>]*>/gi) || [];
    for (const src of scriptMatches) {
      if (/google-analytics/.test(src)) scripts.push({ name: 'Google Analytics', category: 'analytics' });
      if (/facebook.*fbevents/.test(src)) scripts.push({ name: 'Facebook Pixel', category: 'advertising' });
      if (/googleadservices/.test(src)) scripts.push({ name: 'Google Ads Conversion', category: 'advertising' });
      if (/hotjar/.test(src)) scripts.push({ name: 'Hotjar', category: 'analytics' });
      if (/checkout\.stripe/.test(src)) payments.push({ name: 'Stripe Checkout', category: 'payment' });
      if (/razorpay/.test(src)) payments.push({ name: 'Razorpay', category: 'payment' });
      if (/paypal/.test(src)) payments.push({ name: 'PayPal', category: 'payment' });
      if (/woocommerce/.test(src)) payments.push({ name: 'WooCommerce', category: 'ecommerce-platform' });
      if (/shopify/.test(src)) payments.push({ name: 'Shopify', category: 'ecommerce-platform' });
    }

    const technologies = { cookies, scripts, payments };

    // ------------------------------------------
    // ?? ULTRA SMART BUSINESS DETECTION
    // ------------------------------------------
    const businessDetection = detectBusinessTypeAdvanced(html, url, technologies);

    // ------------------------------------------
    // ?? CONTEXT-AWARE PAGE CHECKING
    // ------------------------------------------
    const pageCheck = checkRequiredPages(html, url, businessDetection.profile);

    // ------------------------------------------
    // ?? SMART RECOMMENDATIONS
    // ------------------------------------------
    const recommendations = generateRecommendations(businessDetection, pageCheck, technologies);

    // ------------------------------------------
    // ?? COMPLIANCE SCORE (WEIGHTED)
    // ------------------------------------------
    let weightedScore = 0;
    let maxPossibleScore = 0;

    for (const page of businessDetection.profile.requiredPages || []) {
      const weight = page.priority === 'critical' ? 3 : page.priority === 'high' ? 2 : 1;
      maxPossibleScore += weight;

      const isFound = pageCheck.found.some(f => f.type === page.type);
      if (isFound) weightedScore += weight;
    }

    const finalScore = maxPossibleScore > 0 ? Math.round((weightedScore / maxPossibleScore) * 100) : null;

    // Determine overall status
    let status, statusColor, statusMessage;
    if (!finalScore || finalScore < 30) {
      status = 'critical';
      statusColor = 'red';
      statusMessage = '?? Major compliance gaps - Immediate action required';
    } else if (finalScore < 60) {
      status = 'warning';
      statusColor = 'orange';
      statusMessage = '? Several important pages missing - Urgent attention needed';
    } else if (finalScore < 85) {
      status = 'good';
      statusColor = 'yellow';
      statusMessage = '? Good foundation - Minor improvements possible';
    } else {
      status = 'excellent';
      statusColor = 'green';
      statusMessage = '?? Excellent compliance posture!';
    }

    // Build final response
    return {
      version: '3.0.0',
      scannedAt: new Date().toISOString(),
      url,
      statusCode: resp.status,
      scanDurationMs: Date.now() - startTime,

      // ?? BUSINESS INTELLIGENCE
      businessIntelligence: {
        detectedType: businessDetection.type,
        typeName: businessDetection.name,
        typeIcon: businessDetection.icon,
        confidence: businessDetection.confidence,
        confidenceLevel: businessDetection.confidence > 80 ? 'High' : businessDetection.confidence > 50 ? 'Medium' : 'Low',
        evidence: businessDetection.evidence,
        alternatives: businessDetection.alternatives,

        // Applicable regulations for THIS business
        regulations: businessDetection.profile.regulations || []
      },

      // Technologies found
      technologies: {
        summary: {
          totalCookies: cookies.length,
          totalScripts: scripts.length,
          paymentGateways: payments.length,
          hasAnalytics: scripts.some(s => s.category === 'analytics'),
          hasAdvertising: scripts.some(s => s.category === 'advertising'),
          hasChatWidget: scripts.some(s => s.category === 'chat'),
          dataCollectionLevel: cookies.length > 5 ? 'extensive' : cookies.length > 2 ? 'moderate' : 'minimal'
        },
        details: { cookies, scripts, payments }
      },

      // ?? CONTEXT-AWARE LEGAL ANALYSIS
      legalAnalysis: {
        businessType: businessDetection.type,
        businessTypeName: businessDetection.name,

        // Only RELEVANT required pages
        requiredPages: (businessDetection.profile.requiredPages || []).map(p => ({
          type: p.type,
          label: p.label,
          whyNeeded: p.reason,
          priority: p.priority,
          riskIfMissing: p.riskIfMissing,
          effort: p.effort,
          hasTemplate: p.templateAvailable
        })),

        // Found pages
        foundPages: pageCheck.found,

        // Missing pages (with penalties!)
        missingPages: pageCheck.missing,

        // Optional but nice-to-have
        optionalPages: businessDetection.profile.optionalPages || [],

        // Smart scoring
        scores: {
          compliancePercentage: finalScore,
          weightedScore: finalScore,
          totalRelevantRequired: pageCheck.totalRequired,
          totalFound: pageCheck.totalFound,
          status,
          statusColor,
          statusMessage
        },

        // Summary message
        summary: {
          headline: pageCheck.missing.filter(p => p.priority === 'critical').length > 0
            ? `?? ${pageCheck.missing.filter(p => p.priority === 'critical').length} CRITICAL pages missing`
            : pageCheck.missing.length > 0
              ? `?? ${pageCheck.missing.length} important pages need attention`
              : '? All critical pages present!',
          detail: `${pageCheck.totalFound}/${pageCheck.totalRequired} relevant pages found (${finalScore}% compliant)`
        }
      },

      // ?? ACTIONABLE RECOMMENDATIONS
      recommendations: {
        total: recommendations.length,
        immediate: recommendations.filter(r => r.priority === 'immediate').length,
        urgent: recommendations.filter(r => r.priority === 'urgent').length,
        items: recommendations.slice(0, 10), // Top 10
        estimatedTotalEffort: recommendations.reduce((acc, r) => acc + (r.effort === 'small' ? 4 : r.effort === 'medium' ? 12 : 40), 0) // Hours
      },

      // Quick facts
      quickFacts: {
        businessType: `${businessDetection.icon} ${businessDetection.name}`,
        confidence: `${businessDetection.confidence}% confident`,
        complianceStatus: `${finalScore ?? 0}%`,
        criticalIssues: pageCheck.missing.filter(p => p.priority === 'critical').length,
        hasPaymentProcessing: payments.length > 0,
        collectsPersonalData: cookies.length > 0 || /type=["']email["']/i.test(html),
        needsImmediateAction: pageCheck.missing.some(p => p.priority === 'critical')
      }
    };

  } catch (err) {
    throw new Error(`Scan failed: ${err.message}`);
  }
}

