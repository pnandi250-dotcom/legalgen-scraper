  version: '3.0.0',
  engine: 'Ultra-Smart Business Intelligence v3.0',
  features: [
    'Multi-signal business detection',
    'Context-aware legal requirements',
    'Indian regulation mapping',
    'Penalty estimation',
    'Priority-based recommendations'
  ]
}));

app.post('/api/scan', auth, async (req, res) => {
  const { url } = req.body;
  if (!url) return res.status(400).json({ error: 'URL required' });

  try {
    console.log(`?? Ultra-smart scanning: ${url}`);
    const result = await scanWebsiteUltraSmart(url);
    console.log(`? Scan complete: ${result.businessIntelligence.typeName} (${result.businessIntelligence.confidence}% confidence)`);
    res.json({ success: true, data: result });
  } catch (err) {
    console.error('? Error:', err.message);
    res.status(500).json({ error: err.message });
  }
});

