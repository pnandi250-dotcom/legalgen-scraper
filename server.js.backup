    ]
  },

  // --- PORTFOLIO / FREELANCER --------------------------
  'portfolio': {
    name: 'Portfolio / Freelancer',
    icon: '??',

    signals: {
      htmlPatterns: [
        { pattern: /portfolio|work|project|case.?study/i, weight: 5, label: 'Portfolio' },
        { pattern: /hire|freelance|available|for.?hire|let'?s.?work/i, weight: 4, label: 'Hiring' },
        { pattern: /skill|experience|expertise|specialist/i, weight: 2, label: 'Skills' },
        { pattern: /resume|cv|download|linkedin/i, weight: 2, label: 'Resume' },
        { pattern: /contact|email|message/i, weight: 1, label: 'Contact' }
      ],
      urlPatterns: [/portfolio/, /work/, /hire/, /me/],
      techPatterns: [],
      schemaTypes: ['Person', 'WebSite']
    },

